# Copy to `.env` next to docker-compose.prod.yml on the server, fill it, keep it out of git (chmod 600).
# Generate a secret with: openssl rand -hex 32

DOC_DB_PASSWORD=
DOC_SESSION_SECRET=
DOC_ADMIN_LOGIN=admin
DOC_ADMIN_PASSWORD=
DOC_BASE_URL=https://doc.easyweb-quality.fr

# closed until you decide otherwise
DOC_SIGNUP=closed
DOC_SUBMISSIONS=closed

# secret of the webhook that asks for a package to be read (empty: no webhook)
DOC_HOOK_SECRET=

# the image to run: latest, or a tag such as main or sha-1234567
DOC_TAG=latest
