import describe, it, expect, finish from "@test"
import Docs, Change from "./Docs.q"
import fresh_docs from "./TestSupport.q"

fun admin(docs: Docs) -> int
    docs.create_account("quentin", "a long enough password", "admin", none).unwrap()
end

fun test_suite()
    describe("accounts", fun()
        it("signs in with the right password only", fun()
            let docs = fresh_docs()
            admin(docs)
            expect(docs.authenticate("quentin", "a long enough password") != none).to_be(true)
            expect(docs.authenticate("quentin", "wrong password!!") == none).to_be(true)
            expect(docs.authenticate("nobody", "a long enough password") == none).to_be(true)
        end)

        it("refuses short passwords and double logins", fun()
            let docs = fresh_docs()
            expect(docs.create_account("quentin", "short", "admin", none).is_err()).to_be(true)
            admin(docs)
            expect(docs.create_account("quentin", "another long password", "editor", none).is_err()).to_be(true)
        end)
    end)

    describe("folders and pages", fun()
        it("keeps addresses unique in a folder, and nests", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let guide = docs.create_folder("fr", none, "Guide", "", me).unwrap()
            let inner = docs.create_folder("fr", guide, "Les types", "", me).unwrap()
            expect(docs.create_folder("fr", none, "Guide", "", me).is_err()).to_be(true)
            expect(docs.create_folder("fr", none, "Autre", "Bad Slug", me).is_err()).to_be(true)
            let page = docs.create_page("fr", inner, "Entiers", "", "# Entiers\n\nDes `int`.", "edit", me).unwrap()
            expect(docs.create_page("fr", inner, "Entiers", "", "x", "edit", me).is_err()).to_be(true)
            expect(docs.store.page(page).unwrap().html.contains("<h1 id=\"entiers\">Entiers</h1>")).to_be(true)
        end)

        it("refuses to move a folder into itself, and to delete one that is not empty", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let a = docs.create_folder("fr", none, "A", "", me).unwrap()
            let b = docs.create_folder("fr", a, "B", "", me).unwrap()
            expect(docs.move_folder(a, b, me).is_err()).to_be(true)
            expect(docs.move_folder(a, a, me).is_err()).to_be(true)
            expect(docs.delete_folder(a, me).is_err()).to_be(true)
            expect(docs.move_folder(b, none, me).is_ok()).to_be(true)
            expect(docs.delete_folder(a, me).is_ok()).to_be(true)
        end)

        it("makes a revision at each real change, and goes back", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let id = docs.create_page("fr", none, "Intro", "", "one", "edit", me).unwrap()
            expect(docs.edit_page(id, "Intro", "one", "", "edit", me).unwrap()).to_be(1)
            expect(docs.edit_page(id, "Intro", "one\ntwo", "added two", "edit", me).unwrap()).to_be(2)
            expect(docs.edit_page(id, "Intro", "three", "", "edit", me).unwrap()).to_be(3)
            expect(docs.store.revisions(id).len()).to_be(3)
            expect(docs.restore_revision(id, 1, me).unwrap()).to_be(4)
            expect(docs.store.page(id).unwrap().markdown).to_be("one")
            expect(docs.store.revision(id, 2).unwrap().summary).to_be("added two")
        end)

        it("imports Markdown, then updates the same page on a new import", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let first = docs.import_markdown("en", none, "docs/getting-started.md", "---\ntitle: \"Hello there\"\n---\n# Ignored\n\nBody", me).unwrap().id
            let page = docs.store.page(first).unwrap()
            expect(page.title).to_be("Hello there")
            expect(page.slug).to_be("getting-started")
            expect(page.markdown.starts_with("# Ignored")).to_be(true)
            let again = docs.import_markdown("en", none, "getting-started.md", "# New title\n\nChanged", me).unwrap()
            expect(again.created).to_be(false)
            expect(again.revision).to_be(2)
            expect(docs.store.page(first).unwrap().title).to_be("New title")
            expect(docs.import_markdown("en", none, "empty.md", "   ", me).is_err()).to_be(true)
        end)

        it("keeps the last text of a deleted page in the log", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let id = docs.create_page("fr", none, "Gone", "", "last words", "edit", me).unwrap()
            docs.delete_page(id, me)
            expect(docs.store.page(id) == none).to_be(true)
            let log = docs.store.audit("page", 10, 0)
            expect(log[0].action).to_be("page.delete")
            expect(log[0].data.contains("last words")).to_be(true)
        end)
    end)

    describe("audit", fun()
        it("logs who did what, with the size of the diff", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let id = docs.create_page("fr", none, "Log", "", "a\nb", "edit", me).unwrap()
            docs.edit_page(id, "Log", "a\nc\nd", "", "edit", me)
            let log = docs.store.audit("page", 10, 0)
            expect(log[0].action).to_be("page.edit")
            expect(log[0].user).to_be("quentin")
            expect(log[0].data.contains("\"added\":2")).to_be(true)
            expect(log[0].data.contains("\"removed\":1")).to_be(true)
            expect(docs.store.audit_count("page")).to_be(2)
        end)
    end)

    describe("releases", fun()
        it("freezes the pages, publishes, and goes back", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let id = docs.create_page("fr", none, "Intro", "", "version one", "edit", me).unwrap()
            let v1 = docs.create_release("1.11.0", "1.11.0", "first", true, me).unwrap()
            docs.edit_page(id, "Intro", "version two", "", "edit", me)
            let v2 = docs.create_release("1.12.0", "1.12.0", "", true, me).unwrap()
            expect(docs.store.current_release_id()).to_be(v2)
            expect(docs.store.release_page(v1, "fr", "intro").unwrap().markdown).to_be("version one")
            expect(docs.store.release_page(v2, "fr", "intro").unwrap().markdown).to_be("version two")
            docs.publish(v1, me)
            expect(docs.store.current_release_id()).to_be(v1)
            expect(docs.store.audit("release", 1, 0)[0].action).to_be("release.rollback")
            expect(docs.delete_release(v1, me).is_err()).to_be(true)
            expect(docs.delete_release(v2, me).is_ok()).to_be(true)
        end)

        it("refuses a name used twice and an empty documentation", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            expect(docs.create_release("1.0.0", "", "", false, me).is_err()).to_be(true)
            docs.create_page("fr", none, "A", "", "x", "edit", me)
            expect(docs.create_release("1.0.0", "", "", false, me).is_ok()).to_be(true)
            expect(docs.create_release("1.0.0", "", "", false, me).is_err()).to_be(true)
            expect(docs.create_release("bad name", "", "", false, me).is_err()).to_be(true)
        end)

        it("lists what changed since the published release", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let a = docs.create_page("fr", none, "A", "", "a", "edit", me).unwrap()
            let b = docs.create_page("fr", none, "B", "", "b", "edit", me).unwrap()
            docs.create_release("1.0.0", "", "", true, me)
            docs.edit_page(a, "A", "a changed", "", "edit", me)
            docs.delete_page(b, me)
            docs.create_page("fr", none, "C", "", "c", "edit", me)
            let kinds = docs.pending_changes().map(fun(c: Change) -> string "{c.kind}:{c.path}" end)
            expect(kinds.contains("changed:a")).to_be(true)
            expect(kinds.contains("deleted:b")).to_be(true)
            expect(kinds.contains("new:c")).to_be(true)
            expect(kinds.len()).to_be(3)
        end)

        it("puts a release back in the working copy as new revisions", fun()
            let docs = fresh_docs()
            let me = admin(docs)
            let folder = docs.create_folder("fr", none, "Guide", "", me).unwrap()
            let id = docs.create_page("fr", folder, "Intro", "", "original", "edit", me).unwrap()
            let v1 = docs.create_release("1.0.0", "", "", true, me).unwrap()
            docs.edit_page(id, "Intro", "spoiled", "", "edit", me)
            docs.delete_page(id, me)
            expect(docs.restore_release(v1, me).unwrap()).to_be(1)
            let back = docs.store.find_page("fr", folder, "intro").unwrap()
            expect(back.markdown).to_be("original")
        end)
    end)

    finish()
end
